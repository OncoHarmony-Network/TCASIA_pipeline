# Optional local shell shortcuts.
# Snakemake reads workflow settings from config/*.yml; no .env file is required.

TCASIA_REFERENCE_DIR=/path/to/references/gencode_v34
TCASIA_ALIGNMENT_OUTPUT=/path/to/output/alignment
TCASIA_AS_OUTPUT=/path/to/output/as_calling
TCASIA_MAJIQ_LICENSE=/path/to/majiq_license_academic_official.lic
