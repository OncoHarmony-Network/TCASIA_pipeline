# MAJIQ workflow rules. An academic license is required.

rule majiq_create_ini:
    input:
        bam=SAMPLE_BAM,
    output:
        ini=str(OUTPUT_DIR / "work" / "majiq" / "{sample}" / "build.ini"),
    params:
        read_len=int(config["read_len"]),
        genome=config.get("majiq", {}).get("genome", "hg38"),
        strandness=MAJIQ_STRANDNESS,
        bam_dir=lambda wildcards: str(BAM_DIR / wildcards.sample),
        bam_stem=lambda wildcards: f"{wildcards.sample}_Aligned.sortedByCoord.out",
    log:
        str(LOG_DIR / "majiq" / "{sample}.config.log"),
    conda:
        "../envs/MAJIQ.yaml"
    shell:
        """
        mkdir -p "$(dirname {output.ini:q})" "$(dirname {log:q})"
        printf '[info]\nreadlen=%s\nbamdirs=%s\ngenome=%s\nstrandness=%s\n[experiments]\n%s=%s\n' \
            {params.read_len:q} {params.bam_dir:q} {params.genome:q} \
            {params.strandness:q} {wildcards.sample:q} {params.bam_stem:q} \
            > {output.ini:q} 2> {log:q}
        """


rule majiq_build:
    input:
        ini=str(OUTPUT_DIR / "work" / "majiq" / "{sample}" / "build.ini"),
    output:
        majiq=str(OUTPUT_DIR / "{sample}" / "majiq" / "{sample}_Aligned.sortedByCoord.out.majiq"),
        sj=str(OUTPUT_DIR / "{sample}" / "majiq" / "{sample}_Aligned.sortedByCoord.out.sj"),
        sql=str(OUTPUT_DIR / "{sample}" / "majiq" / "splicegraph.sql"),
    threads: int(THREADS.get("majiq", 8))
    params:
        output_dir=lambda wildcards: str(OUTPUT_DIR / wildcards.sample / "majiq"),
        gff=config["GFF"],
        license=config["MAJIQ_license"],
        minreads=int(config.get("majiq", {}).get("minreads", 10)),
    log:
        str(LOG_DIR / "majiq" / "{sample}.build.log"),
    conda:
        "../envs/MAJIQ.yaml"
    shell:
        """
        mkdir -p {params.output_dir:q} "$(dirname {log:q})"
        majiq --license {params.license:q} build {params.gff:q} \
            -c {input.ini:q} -j {threads} -o {params.output_dir:q} \
            --minreads {params.minreads} > {log:q} 2>&1
        """


rule majiq_psi:
    input:
        majiq=str(OUTPUT_DIR / "{sample}" / "majiq" / "{sample}_Aligned.sortedByCoord.out.majiq"),
    output:
        psi=str(OUTPUT_DIR / "{sample}" / "majiq" / "{sample}.psi.tsv"),
        voila=str(OUTPUT_DIR / "{sample}" / "majiq" / "{sample}.psi.voila"),
    threads: int(THREADS.get("majiq", 8))
    params:
        license=config["MAJIQ_license"],
        output_dir=lambda wildcards: str(OUTPUT_DIR / wildcards.sample / "majiq"),
    log:
        str(LOG_DIR / "majiq" / "{sample}.psi.log"),
    conda:
        "../envs/MAJIQ.yaml"
    shell:
        """
        majiq --license {params.license:q} psi {input.majiq:q} \
            -n {wildcards.sample:q} -j {threads} -o {params.output_dir:q} > {log:q} 2>&1
        """


rule voila_modulize:
    input:
        sql=str(OUTPUT_DIR / "{sample}" / "majiq" / "splicegraph.sql"),
        voila=str(OUTPUT_DIR / "{sample}" / "majiq" / "{sample}.psi.voila"),
    output:
        modules=directory(str(OUTPUT_DIR / "{sample}" / "majiq" / "modulized")),
    threads: int(THREADS.get("voila", 4))
    params:
        license=config["MAJIQ_license"],
    log:
        str(LOG_DIR / "majiq" / "{sample}.modulize.log"),
    conda:
        "../envs/MAJIQ.yaml"
    shell:
        """
        voila --license {params.license:q} modulize -d {output.modules:q} \
            {input.sql:q} {input.voila:q} -j {threads} > {log:q} 2>&1
        """


rule voila_tsv:
    input:
        sql=str(OUTPUT_DIR / "{sample}" / "majiq" / "splicegraph.sql"),
        voila=str(OUTPUT_DIR / "{sample}" / "majiq" / "{sample}.psi.voila"),
    output:
        result=str(OUTPUT_DIR / "{sample}" / "majiq" / "{sample}.voila.tsv"),
    threads: int(THREADS.get("voila", 4))
    params:
        license=config["MAJIQ_license"],
    log:
        str(LOG_DIR / "majiq" / "{sample}.tsv.log"),
    conda:
        "../envs/MAJIQ.yaml"
    shell:
        """
        voila --license {params.license:q} tsv -f {output.result:q} \
            {input.sql:q} {input.voila:q} -j {threads} > {log:q} 2>&1
        """
