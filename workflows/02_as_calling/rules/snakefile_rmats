# rMATS is run per sample with statistics disabled to obtain PSI values.

rule rmats_create_input:
    input:
        bam=SAMPLE_BAM,
    output:
        txt=str(OUTPUT_DIR / "work" / "rmats" / "{sample}.txt"),
    log:
        str(LOG_DIR / "rmats" / "{sample}.input.log"),
    conda:
        "../envs/rmats.yaml"
    shell:
        """
        mkdir -p "$(dirname {output.txt:q})" "$(dirname {log:q})"
        printf '%s\n' {input.bam:q} > {output.txt:q} 2> {log:q}
        """


rule rmats_run:
    input:
        bam_list=str(OUTPUT_DIR / "work" / "rmats" / "{sample}.txt"),
    output:
        results=directory(str(OUTPUT_DIR / "{sample}" / "rmats")),
    threads: int(THREADS.get("rmats", 10))
    params:
        gtf=config["ref"],
        read_len=int(config["read_len"]),
        library_type=RMATS_LIBRARY_TYPE,
        cstat=float(config.get("rmats", {}).get("cstat", 0.0001)),
        tmp=lambda wildcards: str(OUTPUT_DIR / "work" / "rmats" / f"{wildcards.sample}.tmp"),
        extra=config.get("rmats", {}).get("extra", ""),
    log:
        str(LOG_DIR / "rmats" / "{sample}.log"),
    conda:
        "../envs/rmats.yaml"
    shell:
        """
        mkdir -p {params.tmp:q} "$(dirname {log:q})"
        rmats.py \
            --b1 {input.bam_list:q} \
            --gtf {params.gtf:q} \
            --readLength {params.read_len} \
            --nthread {threads} \
            --od {output.results:q} \
            --tmp {params.tmp:q} \
            --libType {params.library_type} \
            --cstat {params.cstat} \
            --statoff \
            --variable-read-length \
            -t paired {params.extra} \
            > {log:q} 2>&1
        """
