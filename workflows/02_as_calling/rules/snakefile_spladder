# SplAdder workflow rules.

rule spladder_run:
    input:
        bam=SAMPLE_BAM,
    output:
        results=directory(str(OUTPUT_DIR / "{sample}" / "spladder")),
    threads: int(THREADS.get("spladder", 8))
    params:
        annotation=config["ref"],
        confidence=int(config.get("spladder", {}).get("confidence", 3)),
        merge_strategy=config.get("spladder", {}).get("merge_strategy", "single"),
        event_types=config.get("spladder", {}).get(
            "event_types",
            "exon_skip,intron_retention,alt_3prime,alt_5prime,mutex_exons",
        ),
    log:
        str(LOG_DIR / "spladder" / "{sample}.log"),
    conda:
        "../envs/spladder.yaml"
    shell:
        """
        mkdir -p {output.results:q} "$(dirname {log:q})"
        spladder build \
            --bams {input.bam:q} \
            --annotation {params.annotation:q} \
            --outdir {output.results:q} \
            --parallel {threads} \
            --merge-strat {params.merge_strategy} \
            --event-types {params.event_types} \
            --confidence {params.confidence} -v > {log:q} 2>&1
        """
