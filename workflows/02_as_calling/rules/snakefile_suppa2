# SUPPA2 workflow rules.

rule salmon_quant:
    input:
        fq1=SAMPLE_FASTQ_1,
        fq2=SAMPLE_FASTQ_2,
    output:
        quant_file=str(OUTPUT_DIR / "work" / "suppa2" / "{sample}" / "quant.sf"),
    threads: int(THREADS.get("salmon", 8))
    params:
        index=config["SALMON_INDEX"],
        output_dir=lambda wildcards: str(OUTPUT_DIR / "work" / "suppa2" / wildcards.sample),
        library_type=SALMON_LIBRARY_TYPE,
    log:
        str(LOG_DIR / "suppa2" / "{sample}.salmon.log"),
    conda:
        "../envs/SUPPA2.yaml"
    shell:
        """
        mkdir -p "$(dirname {log:q})"
        salmon quant -i {params.index:q} -l {params.library_type} \
            --gcBias --validateMappings \
            -1 {input.fq1:q} -2 {input.fq2:q} \
            -p {threads} -o {params.output_dir:q} > {log:q} 2>&1
        """


rule select_suppa_fields:
    input:
        quant_file=str(OUTPUT_DIR / "work" / "suppa2" / "{sample}" / "quant.sf"),
    output:
        iso_tpm=str(OUTPUT_DIR / "work" / "suppa2" / "{sample}" / "iso_tpm.txt"),
    log:
        str(LOG_DIR / "suppa2" / "{sample}.select_fields.log"),
    conda:
        "../envs/SUPPA2.yaml"
    shell:
        "multipleFieldSelection.py -i {input.quant_file:q} -k 1 -f 4 -o {output.iso_tpm:q} > {log:q} 2>&1"


rule format_suppa_fields:
    input:
        iso_tpm=str(OUTPUT_DIR / "work" / "suppa2" / "{sample}" / "iso_tpm.txt"),
    output:
        formatted=str(OUTPUT_DIR / "work" / "suppa2" / "{sample}" / "iso_tpm_formatted.txt"),
    log:
        str(LOG_DIR / "suppa2" / "{sample}.format_fields.log"),
    conda:
        "../envs/SUPPA2.yaml"
    shell:
        "perl -alne '{{/(\\|.*\\|)\t/; s/$1//g; s/\\|//g; print}}' {input.iso_tpm:q} > {output.formatted:q} 2> {log:q}"


rule suppa_run:
    input:
        iso_tpm=str(OUTPUT_DIR / "work" / "suppa2" / "{sample}" / "iso_tpm_formatted.txt"),
    output:
        result=str(OUTPUT_DIR / "{sample}" / "suppa2" / "{sample}_event.psi"),
    params:
        events=config["suppa2_events"],
        output_prefix=lambda wildcards: str(
            OUTPUT_DIR / wildcards.sample / "suppa2" / f"{wildcards.sample}_event"
        ),
        min_tpm=float(config.get("suppa2", {}).get("min_tpm", 1)),
    log:
        str(LOG_DIR / "suppa2" / "{sample}.psi.log"),
    conda:
        "../envs/SUPPA2.yaml"
    shell:
        """
        mkdir -p "$(dirname {output.result:q})" "$(dirname {log:q})"
        suppa.py psiPerEvent -i {params.events:q} -f {params.min_tpm} \
            -e {input.iso_tpm:q} -o {params.output_prefix:q} > {log:q} 2>&1
        """
